# AstraVital AI - Environment Variables
PORT=3000
NODE_ENV=development

# NASA Open API Key (Default demo key is DEMO_KEY, replace with your api.nasa.gov key)
NASA_API_KEY=DEMO_KEY

# Supabase Credentials (Optional for local mode, required for cloud PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
